{
  "name": "muc-student",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release:version": "node scripts/release-version.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles nsis",
    "tauri:android:dev": "node scripts/tauri-android.mjs dev",
    "tauri:android:check": "node scripts/tauri-android.mjs check",
    "tauri:android:build": "node scripts/tauri-android.mjs build",
    "format": "prettier --write \"*.{json,ts,tsx,css,mjs}\" \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \".github/workflows/*.{yml,yaml}\" \"src-tauri/tauri.conf.json\"",
    "format:check": "prettier --check \"*.{json,ts,tsx,css,mjs}\" \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \".github/workflows/*.{yml,yaml}\" \"src-tauri/tauri.conf.json\"",
    "lint": "eslint src/**/*.{ts,tsx} vite.config.ts",
    "lint:fix": "eslint src/**/*.{ts,tsx} vite.config.ts --fix",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
